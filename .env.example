KAKAO_REST_API_KEY=
OPINET_API_KEY=
GCP_PROJECT_ID=
EVIDENCE_BUCKET=
# 로컬 개발은 memory, Cloud Run 배포는 cloudbuild.yaml에서 firestore로 전환합니다.
CACHE_BACKEND=memory

# 접근제어는 게시글 버튼과 OWNER_ACCESS_KEY 설정을 마친 뒤 true로 전환합니다.
ACCESS_CONTROL_ENABLED=false
# 현재는 link 사용. 게시판이 Referer를 보존하게 되면 referer로 전환 가능.
ACCESS_ENTRY_MODE=link
OWNER_ACCESS_KEY=
ACCESS_COOKIE_NAME=ddalkkak_access
